      "speaker_affiliation_bucket": "corporate",
      "speaker_affiliation_kind": "Berkshire Hathaway",
      "exact_quote": "\"As Chairman Emeritus, Mr. Buffett will remain a member of the Board of Directors and will continue to offer his valued judgment and perspective,\"",
      "attributive_verb": "said",
      "stance_toward_target": "neutral",
      "signal_text_idx": 8,
